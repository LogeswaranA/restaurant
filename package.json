  "version": "1.0.0",
  "description": "Restaurant website theme with a landing page and a booking page that stores requests in SQLite through a small Node API (Vite + vanilla HTML/CSS/JS).",
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "start:api": "node --disable-warning=ExperimentalWarning server/index.js",
